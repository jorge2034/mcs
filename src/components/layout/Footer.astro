---
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo2.PNG';

const links = {
  empresa: [
    { href: '/quienes-somos', label: 'Quiénes Somos' },
    { href: '/servicios', label: 'Servicios' },
    { href: '/minerales', label: 'Minerales' },
    { href: '/lme', label: 'Precios LME' },
  ],
  recursos: [
    { href: '/noticias', label: 'Noticias' },
    { href: '/noticias?cat=responsabilidad', label: 'Responsabilidad Social' },
    { href: '/noticias?cat=proyectos', label: 'Proyectos' },
    { href: '/contacto', label: 'Contacto' },
  ],
};
---

<footer class="bg-[#0D0D0D] text-white">
  <!-- Main Footer -->
  <div class="border-t-2 border-[#C41230]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

        <!-- Brand -->
        <div class="lg:col-span-2">
          <a href="/" class="inline-block mb-6">
            <Image
              src={logoImg}
              alt="Minera La Cordillera del Sur"
              class="h-20 w-auto object-contain"
              widths={[160, 240, 320]}
              sizes="160px"
            />
          </a>
          <p class="text-white/60 text-sm leading-relaxed mb-6 max-w-sm">
            Especialistas en el comercio mayorista de minerales, ofreciendo materia prima de alta calidad para impulsar el crecimiento de la industria boliviana.
          </p>
          <!-- Social Networks -->
          <div class="flex items-center gap-3">
            <a href="#" class="w-9 h-9 rounded bg-white/10 hover:bg-[#C41230] flex items-center justify-center transition-colors" aria-label="Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded bg-white/10 hover:bg-[#C41230] flex items-center justify-center transition-colors" aria-label="LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded bg-white/10 hover:bg-[#C41230] flex items-center justify-center transition-colors" aria-label="WhatsApp">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>

        <!-- Links -->
        <div>
          <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-5 flex items-center gap-2">
            <span class="w-4 h-0.5 bg-[#C41230]"></span>
            La Empresa
          </h3>
          <ul class="space-y-3">
            {links.empresa.map(link => (
              <li>
                <a href={link.href} class="text-white/60 hover:text-[#C9A84C] text-sm transition-colors flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#C41230] opacity-50"></span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-white font-bold text-sm uppercase tracking-widest mb-5 flex items-center gap-2">
            <span class="w-4 h-0.5 bg-[#C41230]"></span>
            Recursos
          </h3>
          <ul class="space-y-3">
            {links.recursos.map(link => (
              <li>
                <a href={link.href} class="text-white/60 hover:text-[#C9A84C] text-sm transition-colors flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#C41230] opacity-50"></span>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <!-- Contact Info -->
          <div class="mt-8 space-y-2">
            <div class="flex items-center gap-2 text-white/60 text-sm">
              <svg class="w-4 h-4 text-[#C41230] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Oruro, Bolivia
            </div>
            <div class="flex items-center gap-2 text-white/60 text-sm">
              <svg class="w-4 h-4 text-[#C41230] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              info@cordilleradelsur.com.bo
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-white/40 text-xs">
        &copy; {new Date().getFullYear()} Minera La Cordillera del Sur S.R.L. — Todos los derechos reservados.
      </p>
      <p class="text-white/30 text-xs">
        Oruro — Bolivia &bull; Desarrollado con excelencia
      </p>
    </div>
  </div>
</footer>
