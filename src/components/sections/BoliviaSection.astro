---
import { Image } from 'astro:assets';
import cascoImg from '../../assets/casco.jpg';
---

<section class="py-24 bg-[#C41230] relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute inset-0 bolivia-pattern"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Content -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <span class="h-px w-12 bg-white/50"></span>
          <span class="text-white/80 text-xs font-bold tracking-[0.3em] uppercase">Nuestro Compromiso</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
          Orgullosamente<br/>
          <span class="text-[#C9A84C]">bolivianos</span>
        </h2>
        <p class="text-white/80 text-lg leading-relaxed mb-6">
          Desde el corazón minero de Bolivia, reafirmamos nuestro compromiso con el desarrollo sostenible, la generación de empleo y el crecimiento industrial.
        </p>
        <p class="text-white/70 leading-relaxed mb-8">
          <strong class="text-white">Oruro representa nuestras raíces</strong>, nuestra identidad y nuestra visión hacia el futuro. Capital histórica de la minería boliviana, cuna de tradición y progreso industrial.
        </p>

        <div class="grid grid-cols-3 gap-6 mb-8">
          {[
            { value: '#1', label: 'Región minera histórica de Bolivia' },
            { value: '400+', label: 'Años de tradición minera en Oruro' },
            { value: '100%', label: 'Capital boliviano' },
          ].map(stat => (
            <div class="text-center">
              <div class="text-white font-black text-2xl mb-1">{stat.value}</div>
              <div class="text-white/60 text-xs leading-tight">{stat.label}</div>
            </div>
          ))}
        </div>

        <a
          href="/quienes-somos#bolivia"
          class="inline-flex items-center gap-2 bg-white text-[#C41230] font-bold px-6 py-3 rounded hover:bg-[#1A1A1A] hover:text-white transition-all duration-300 text-sm"
        >
          Nuestra historia
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Visual: monumento minero Oruro + cards -->
      <div class="space-y-4">
        <div class="rounded-2xl overflow-hidden aspect-[16/10] border border-white/20 shadow-2xl">
          <Image
            src={cascoImg}
            alt="Monumento al casco del minero en Oruro, Bolivia"
            class="w-full h-full object-cover"
            widths={[480, 720, 960]}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: '⛏', title: 'Compromiso Ambiental', desc: 'Operamos con estrictas políticas de responsabilidad ambiental y sostenibilidad.' },
            { icon: '👷', title: 'Empleo Local', desc: 'Generamos empleo de calidad para las comunidades mineras bolivianas.' },
            { icon: '📊', title: 'Transparencia', desc: 'Informes de gestión y reportes de sostenibilidad accesibles al público.' },
            { icon: '🤝', title: 'Responsabilidad Social', desc: 'Programas de inversión social en las comunidades donde operamos.' },
          ].map(item => (
            <div class="bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-xl p-5 transition-colors">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-white font-bold text-sm mb-2">{item.title}</h3>
              <p class="text-white/70 text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
