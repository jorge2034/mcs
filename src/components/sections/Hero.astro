---
import { Image } from 'astro:assets';
import minaImg from '../../assets/mina.jpg';
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-[#0D0D0D]">

  <!-- Background: industrial mine image with overlay -->
  <div class="absolute inset-0 z-0">
    <Image
      src={minaImg}
      alt="Mineros en túnel subterráneo con cascos y lámparas"
      class="absolute inset-0 w-full h-full object-cover"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0D0D0D]/80 via-[#0D0D0D]/50 to-[#0D0D0D]/90"></div>
    <!-- Side gradient for text readability -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0D0D0D]/80 via-transparent to-transparent"></div>
  </div>

  <!-- Animated particles effect -->
  <div class="absolute inset-0 z-10 pointer-events-none" id="hero-particles"></div>

  <!-- Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 sm:py-40">
    <div class="max-w-3xl">

      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6" id="hero-eyebrow">
        <span class="h-px w-12 bg-[#C41230]"></span>
        <span class="text-[#C9A84C] text-xs font-bold tracking-[0.4em] uppercase">Minera La Cordillera del Sur</span>
      </div>

      <!-- Headline -->
      <h1
        id="hero-title"
        class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-white leading-tight mb-6"
      >
        Minerales que<br/>
        <span class="text-gradient-gold">mueven industrias</span>
      </h1>

      <!-- Subtitle -->
      <p id="hero-subtitle" class="text-white/70 text-lg sm:text-xl leading-relaxed mb-10 max-w-2xl">
        Especialistas en comercio mayorista de minerales y desarrollo de proyectos mineros responsables. Desde el corazón andino de Bolivia para el mundo.
      </p>

      <!-- CTAs -->
      <div id="hero-ctas" class="flex flex-wrap gap-4">
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 bg-[#C41230] hover:bg-[#E8193F] text-white font-bold px-8 py-4 rounded transition-all duration-300 hover:shadow-xl hover:shadow-red-900/40 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Solicitar Información
        </a>
        <a
          href="/servicios"
          class="inline-flex items-center gap-2 border border-white/30 hover:border-[#C9A84C] text-white hover:text-[#C9A84C] font-semibold px-8 py-4 rounded transition-all duration-300 backdrop-blur-sm"
        >
          Nuestros Servicios
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Stats Bar -->
  <div class="absolute bottom-0 left-0 right-0 z-20 bg-[#C41230]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-white/20">
        {[
          { value: '10+', label: 'Años de experiencia' },
          { value: '50+', label: 'Clientes activos' },
          { value: '15+', label: 'Minerales comercializados' },
          { value: 'ISO', label: 'Estándares de calidad' },
        ].map(stat => (
          <div class="py-4 px-6 text-center">
            <div class="text-white font-black text-2xl leading-none">{stat.value}</div>
            <div class="text-white/70 text-xs mt-1 uppercase tracking-widest">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-24 right-8 z-20 hidden lg:flex flex-col items-center gap-2">
    <span class="text-white/40 text-xs tracking-widest uppercase" style="writing-mode: vertical-rl">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('#hero-eyebrow', { opacity: 0, x: -30, duration: 0.8 })
    .from('#hero-title', { opacity: 0, y: 40, duration: 1 }, '-=0.4')
    .from('#hero-subtitle', { opacity: 0, y: 30, duration: 0.8 }, '-=0.6')
    .from('#hero-ctas', { opacity: 0, y: 20, duration: 0.6 }, '-=0.4');
</script>
