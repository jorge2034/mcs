---
import SectionTitle from '../ui/SectionTitle.astro';

const sectors = [
  { title: 'Fundición y metalurgia', desc: 'Suministro de concentrados y metales para procesos industriales.' },
  { title: 'Industria química', desc: 'Materias primas minerales con especificaciones técnicas controladas.' },
  { title: 'Exportación', desc: 'Gestión comercial y logística hacia mercados internacionales.' },
  { title: 'Proyectos mineros', desc: 'Acompañamiento desde prospección hasta comercialización.' },
];
---

<section class="py-20 bg-[#F8F8F8] overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <SectionTitle
        eyebrow="Sectores"
        title="Al servicio de la <span class='text-[#C41230]'>industria boliviana</span>"
        subtitle="Trabajamos con empresas que requieren minerales de calidad, trazabilidad y entregas confiables."
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {sectors.map((sector) => (
        <div class="bg-white p-6 border border-gray-100 hover:border-[#C41230]/30 hover:shadow-md transition-all duration-300">
          <div class="w-8 h-0.5 bg-[#C41230] mb-4"></div>
          <h3 class="font-bold text-[#1A1A1A] text-sm mb-2">{sector.title}</h3>
          <p class="text-[#718096] text-sm leading-relaxed">{sector.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 max-w-3xl mx-auto text-center">
      <blockquote class="relative">
        <p class="text-[#4A5568] text-lg leading-relaxed italic mb-6">
          "La calidad constante de los minerales y la puntualidad en las entregas de Minera La Cordillera del Sur han sido fundamentales para la continuidad de nuestros procesos industriales."
        </p>
        <footer class="text-[#718096] text-sm">
          <span class="font-semibold text-[#1A1A1A]">Cliente industrial</span> — Sector metalúrgico boliviano
        </footer>
      </blockquote>
    </div>
  </div>
</section>
