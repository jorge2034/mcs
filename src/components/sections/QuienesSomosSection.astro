---
import { Image } from 'astro:assets';
import SectionTitle from '../ui/SectionTitle.astro';
import minersImg from '../../assets/images.jpeg';
---

<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Visual -->
      <div class="relative order-2 lg:order-1">
        <div class="relative">
          <!-- Main card -->
          <div class="bg-[#1A1A1A] rounded-2xl overflow-hidden aspect-[4/3]">
            <Image
              src={minersImg}
              alt="Mineros bolivianos trabajando con vagoneta de mineral"
              class="w-full h-full object-cover"
              widths={[480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 50vw"
            />
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-6 -right-6 bg-[#C41230] text-white rounded-xl p-5 shadow-2xl">
            <div class="text-3xl font-black leading-none">10+</div>
            <div class="text-xs font-semibold tracking-widest uppercase mt-1 opacity-80">Años</div>
          </div>
          <!-- Corner accent -->
          <div class="absolute -top-4 -left-4 w-24 h-24 border-l-4 border-t-4 border-[#C9A84C] opacity-60"></div>
        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2">
        <SectionTitle
          eyebrow="Quiénes Somos"
          title="Forjados en el <span class='text-[#C41230]'>corazón minero</span> de Bolivia"
          subtitle="MINERA LA CORDILLERA DEL SUR desarrolla proyectos que impulsan el aprovechamiento responsable de los recursos minerales, contribuyendo a la actividad industrial del país."
          align="left"
        />

        <div class="mt-8 space-y-4">
          {[
            { icon: '⛏', title: 'Experiencia Comprobada', desc: 'Más de una década operando en el sector minero boliviano con resultados concretos.' },
            { icon: '🏔', title: 'Raíces Orureñas', desc: 'Orgullosamente orureños, desde la capital histórica de la minería boliviana.' },
            { icon: '🌿', title: 'Sostenibilidad', desc: 'Comprometidos con el desarrollo responsable y la preservación del medioambiente.' },
          ].map(item => (
            <div class="flex gap-4 p-4 rounded-xl hover:bg-gray-50 transition-colors group">
              <div class="w-12 h-12 bg-[#C41230]/10 group-hover:bg-[#C41230] rounded-xl flex items-center justify-center shrink-0 transition-colors text-xl">
                {item.icon}
              </div>
              <div>
                <h3 class="font-bold text-[#1A1A1A] mb-1">{item.title}</h3>
                <p class="text-[#4A5568] text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <a
            href="/quienes-somos"
            class="inline-flex items-center gap-2 bg-[#1A1A1A] hover:bg-[#C41230] text-white font-semibold px-6 py-3 rounded transition-all duration-300 text-sm"
          >
            Conocer más
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
