---
import { Image } from 'astro:assets';
import SectionTitle from '../ui/SectionTitle.astro';
import cascoImg from '../../assets/casco.jpg';
import minersImg from '../../assets/images.jpeg';
import piedrasImg from '../../assets/piedras.avif';

const mockNews = [
  {
    title: 'Minera La Cordillera del Sur refuerza su compromiso con el desarrollo sostenible',
    category: 'Responsabilidad Social',
    date: '28 Jun 2026',
    excerpt: 'La empresa presentó su nuevo plan estratégico de sostenibilidad ambiental para el período 2026-2030, alineado con los objetivos de desarrollo sostenible.',
    image: cascoImg,
    alt: 'Monumento minero en Oruro, símbolo del compromiso con Bolivia',
  },
  {
    title: 'Bolivia consolida su posición como exportador estratégico de estaño a nivel mundial',
    category: 'Sector Minero',
    date: '20 Jun 2026',
    excerpt: 'El sector minero boliviano registró un incremento del 12% en las exportaciones durante el primer semestre, con el estaño y la plata liderando el crecimiento.',
    image: minersImg,
    alt: 'Mineros trabajando en operaciones de extracción de mineral',
  },
  {
    title: 'Nuevas tecnologías de procesamiento de minerales implementadas en Oruro',
    category: 'Tecnología',
    date: '15 Jun 2026',
    excerpt: 'La adopción de tecnologías de procesamiento de última generación permite mejorar la calidad del mineral y reducir el impacto ambiental de las operaciones.',
    image: piedrasImg,
    alt: 'Minerales y piedras del subsuelo boliviano',
  },
];
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-12">
      <SectionTitle
        eyebrow="Noticias"
        title="Últimas <span class='text-[#C41230]'>novedades</span>"
        align="left"
      />
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#C41230] hover:text-[#E8193F] shrink-0"
      >
        Ver todas las noticias
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {mockNews.map((item) => (
        <article class="group">
          <a href="/noticias" class="block rounded-xl overflow-hidden border border-gray-100 hover:border-[#C41230]/30 hover:shadow-xl transition-all duration-300 h-full">
            <div class="aspect-video overflow-hidden bg-[#1A1A1A]">
              <Image
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                widths={[400, 640]}
                sizes="(max-width: 768px) 100vw, 33vw"
              />
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-semibold text-[#C41230] bg-[#C41230]/10 px-2 py-0.5 rounded-full">
                  {item.category}
                </span>
                <span class="text-xs text-[#718096]">{item.date}</span>
              </div>
              <h3 class="font-bold text-[#1A1A1A] text-base leading-snug mb-2 group-hover:text-[#C41230] transition-colors line-clamp-2">
                {item.title}
              </h3>
              <p class="text-[#718096] text-sm leading-relaxed line-clamp-2">{item.excerpt}</p>
              <div class="mt-4 flex items-center gap-1 text-[#C41230] text-xs font-semibold">
                Leer más
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
