---
import SectionTitle from '../ui/SectionTitle.astro';
import ContactForm from '../vue/ContactForm.vue';
---

<section class="py-24 bg-[#1A1A1A] relative overflow-hidden">
  <div class="absolute inset-0 opacity-5"
    style="background-image: repeating-linear-gradient(45deg, #C41230 0, #C41230 1px, transparent 0, transparent 30px);">
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Info -->
      <div>
        <SectionTitle
          eyebrow="Contacto"
          title="Hablemos sobre su <span class='text-[#C9A84C]'>proyecto minero</span>"
          subtitle="Nuestro equipo de especialistas está listo para asesorarle sobre comercialización de minerales y desarrollo de proyectos."
          align="left"
          light
        />

        <div class="mt-10 space-y-6">
          {[
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
              label: 'Dirección',
              value: 'Oruro, Bolivia'
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
              label: 'Teléfono',
              value: '+591 2 000 0000'
            },
            {
              icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
              label: 'Email',
              value: 'info@cordilleradelsur.com.bo'
            },
          ].map(item => (
            <div class="flex gap-4 items-start">
              <div class="w-10 h-10 bg-[#C41230] rounded-lg flex items-center justify-center text-white shrink-0">
                <Fragment set:html={item.icon} />
              </div>
              <div>
                <div class="text-white/50 text-xs uppercase tracking-widest mb-1">{item.label}</div>
                <div class="text-white font-medium">{item.value}</div>
              </div>
            </div>
          ))}
        </div>

        <!-- Map placeholder -->
        <div class="mt-8 rounded-xl overflow-hidden bg-[#2D2D2D] aspect-video flex items-center justify-center border border-white/10">
          <div class="text-white/30 text-sm text-center">
            <svg class="w-8 h-8 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Google Maps — Oruro, Bolivia
          </div>
        </div>
      </div>

      <!-- Form -->
      <div>
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>
