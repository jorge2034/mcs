---
import SectionTitle from '../ui/SectionTitle.astro';

const services = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 10V7m-8 0v10l8 4"/></svg>`,
    title: 'Comercio Mayorista',
    description: 'Especialistas en la comercialización al por mayor de minerales con los más altos estándares de calidad.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>`,
    title: 'Suministro Industrial',
    description: 'Abastecimiento continuo y confiable de materias primas para procesos industriales exigentes.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    title: 'Logística Minera',
    description: 'Gestión integral de transporte y logística con infraestructura especializada para minerales.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    title: 'Asesoramiento Comercial',
    description: 'Consultoría especializada en mercados internacionales de minerales y precios de referencia LME.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    title: 'Desarrollo de Proyectos',
    description: 'Acompañamos el desarrollo de proyectos mineros desde la prospección hasta la producción.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Control de Calidad',
    description: 'Análisis y certificación de calidad conforme a estándares internacionales para exportación.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Gestión de Exportaciones',
    description: 'Tramitación completa para exportaciones: certificados, permisos, documentación aduanera.',
  },
];
---

<section class="py-24 bg-[#F8F8F8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <SectionTitle
        eyebrow="Nuestros Servicios"
        title="Soluciones integrales para la <span class='text-[#C41230]'>industria minera</span>"
        subtitle="Ofrecemos un portafolio completo de servicios diseñados para satisfacer las exigentes demandas del sector minero nacional e internacional."
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {services.map((service, i) => (
        <div
          class="bg-white rounded-xl p-6 shadow-sm hover:shadow-xl border border-transparent hover:border-[#C41230]/20 transition-all duration-300 group cursor-default"
        >
          <div class="w-14 h-14 bg-[#C41230]/8 group-hover:bg-[#C41230] rounded-xl flex items-center justify-center mb-5 transition-colors text-[#C41230] group-hover:text-white">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="font-bold text-[#1A1A1A] text-base mb-3 group-hover:text-[#C41230] transition-colors">
            {service.title}
          </h3>
          <p class="text-[#718096] text-sm leading-relaxed">{service.description}</p>
        </div>
      ))}

      <!-- CTA Card -->
      <div class="bg-[#C41230] rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-bold text-white text-base mb-3">¿Necesita un servicio específico?</h3>
          <p class="text-white/80 text-sm leading-relaxed">Contáctenos para soluciones personalizadas según sus necesidades.</p>
        </div>
        <a
          href="/contacto"
          class="mt-6 inline-flex items-center justify-center gap-2 bg-white text-[#C41230] font-bold text-sm px-5 py-3 rounded-lg hover:bg-[#1A1A1A] hover:text-white transition-colors"
        >
          Consultar Ahora
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="text-center mt-10">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 border-2 border-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white text-[#1A1A1A] font-semibold px-8 py-3 rounded transition-all duration-300 text-sm"
      >
        Ver todos los servicios
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
