---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  light?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', light = false } = Astro.props;

const alignClass = {
  left: 'text-left items-start',
  center: 'text-center items-center',
  right: 'text-right items-end',
}[align];
---

<div class:list={['flex flex-col gap-3', alignClass]}>
  {eyebrow && (
    <div class="flex items-center gap-3">
      {align !== 'left' && <span class="h-px flex-1 max-w-12 bg-[#C41230]"></span>}
      <span class:list={['text-xs font-bold tracking-[0.3em] uppercase', light ? 'text-[#C9A84C]' : 'text-[#C41230]']}>
        {eyebrow}
      </span>
      {align !== 'right' && <span class="h-px flex-1 max-w-12 bg-[#C41230]"></span>}
    </div>
  )}
  <h2
    class:list={[
      'font-display text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight',
      light ? 'text-white' : 'text-[#1A1A1A]'
    ]}
    set:html={title}
  />
  {subtitle && (
    <p class:list={['text-base sm:text-lg max-w-2xl leading-relaxed', light ? 'text-white/70' : 'text-[#4A5568]']}>
      {subtitle}
    </p>
  )}
</div>
