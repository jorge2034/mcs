---
import BaseLayout from '../layouts/BaseLayout.astro';
import MineralsGrid from '../components/vue/MineralsGrid.vue';
---

<BaseLayout
  title="Minerales"
  description="Catálogo de minerales comercializados por Minera La Cordillera del Sur: plata, estaño, zinc, plomo, antimonio, wolfram y cobre boliviano."
>
  <!-- Hero -->
  <div class="relative pt-20 bg-[#0D0D0D] overflow-hidden">
    <div class="absolute inset-0 opacity-20"
      style="background-image: repeating-linear-gradient(45deg, #C41230 0, #C41230 1px, transparent 0, transparent 40px);">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="flex items-center gap-3 mb-4">
        <a href="/" class="text-white/40 hover:text-white/70 text-sm transition-colors">Inicio</a>
        <span class="text-white/30">/</span>
        <span class="text-[#C9A84C] text-sm">Minerales</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
        Catálogo de <span class="text-[#C41230]">Minerales</span>
      </h1>
      <p class="text-white/60 text-xl max-w-2xl">
        Riqueza mineral del subsuelo boliviano. Productos certificados con trazabilidad completa.
      </p>
    </div>
    <div class="h-1 bg-[#C41230]"></div>
  </div>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <MineralsGrid client:load />
    </div>
  </section>

  <section class="py-16 bg-[#1A1A1A]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white mb-4">
        ¿Busca un mineral específico?
      </h2>
      <p class="text-white/60 mb-8">
        Contáctenos para consultar disponibilidad, especificaciones técnicas y precios de referencia LME.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contacto" class="inline-flex items-center gap-2 bg-[#C41230] hover:bg-[#E8193F] text-white font-bold px-8 py-4 rounded transition-all duration-300">
          Solicitar Cotización
        </a>
        <a href="/lme" class="inline-flex items-center gap-2 border border-[#C9A84C] text-[#C9A84C] hover:bg-[#C9A84C] hover:text-[#0D0D0D] font-semibold px-8 py-4 rounded transition-all duration-300">
          Ver precios LME
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
