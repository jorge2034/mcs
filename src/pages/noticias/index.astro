---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { fetchNews } from '../../lib/api';

const { data: apiNews } = await fetchNews();

const mockNews = [
  { title: 'Minera La Cordillera del Sur refuerza su compromiso con el desarrollo sostenible', category: 'Responsabilidad Social', date: '28 Jun 2026', excerpt: 'La empresa presentó su nuevo plan estratégico de sostenibilidad ambiental para el período 2026-2030.', slug: 'compromiso-sostenible-2026', cover: null },
  { title: 'Bolivia consolida su posición como exportador estratégico de estaño a nivel mundial', category: 'Sector Minero', date: '20 Jun 2026', excerpt: 'El sector minero boliviano registró un incremento del 12% en las exportaciones durante el primer semestre.', slug: 'exportaciones-estano-bolivia', cover: null },
  { title: 'Nuevas tecnologías de procesamiento de minerales implementadas en Oruro', category: 'Tecnología', date: '15 Jun 2026', excerpt: 'La adopción de tecnologías de procesamiento de última generación permite mejorar la calidad del mineral.', slug: 'tecnologias-procesamiento-oruro', cover: null },
];

const news = apiNews.length > 0
  ? apiNews.map(n => ({
      title: n.title,
      category: (n as any).category?.name ?? '',
      date: n.published_at ? new Date(n.published_at).toLocaleDateString('es-BO', { day: 'numeric', month: 'short', year: 'numeric' }) : '',
      excerpt: n.excerpt ?? '',
      slug: n.slug,
      cover: (n as any).cover ?? null,
    }))
  : mockNews;

const categoriesRaw = await fetch(`${import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api'}/news/categories`)
  .then(r => r.json()).catch(() => []);
const categories = ['Todas', ...categoriesRaw.map((c: any) => c.name ?? c).filter(Boolean)];
---

<BaseLayout
  title="Noticias"
  description="Últimas noticias del sector minero boliviano, proyectos, responsabilidad social y novedades de Minera La Cordillera del Sur."
>
  <!-- Hero -->
  <div class="relative pt-20 bg-[#0D0D0D] overflow-hidden">
    <div class="absolute inset-0 opacity-20"
      style="background-image: repeating-linear-gradient(45deg, #C41230 0, #C41230 1px, transparent 0, transparent 40px);">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="flex items-center gap-3 mb-4">
        <a href="/" class="text-white/40 hover:text-white/70 text-sm transition-colors">Inicio</a>
        <span class="text-white/30">/</span>
        <span class="text-[#C9A84C] text-sm">Noticias</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
        Sala de <span class="text-[#C41230]">Prensa</span>
      </h1>
      <p class="text-white/60 text-xl max-w-2xl">
        Noticias, novedades y perspectivas del sector minero boliviano.
      </p>
    </div>
    <div class="h-1 bg-[#C41230]"></div>
  </div>

  <!-- Content -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Categories filter -->
      <div class="flex flex-wrap gap-2 mb-10">
        {categories.map(cat => (
          <button class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors',
            cat === 'Todas'
              ? 'bg-[#C41230] text-white'
              : 'bg-[#F8F8F8] text-[#4A5568] hover:bg-[#C41230]/10 hover:text-[#C41230]'
          ]}>
            {cat}
          </button>
        ))}
      </div>

      <!-- News Grid -->
      {news.length === 0 && (
        <div class="col-span-3 py-20 text-center text-[#718096]">
          No hay noticias publicadas aún.
        </div>
      )}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {news.map(item => (
          <article class="group rounded-2xl overflow-hidden border border-gray-100 hover:border-[#C41230]/30 hover:shadow-xl transition-all duration-300">
            <a href={`/noticias/${item.slug}`}>
              <!-- Image -->
              <div class="bg-gradient-to-br from-[#1A1A1A] to-[#2D2D2D] aspect-video flex items-center justify-center overflow-hidden">
                {item.cover
                  ? <img src={item.cover} alt={item.title} class="w-full h-full object-cover" />
                  : <svg class="w-10 h-10 text-white/20" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                }
              </div>
              <!-- Content -->
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs font-semibold text-[#C41230] bg-[#C41230]/10 px-2 py-0.5 rounded-full">{item.category}</span>
                  <span class="text-xs text-[#718096]">{item.date}</span>
                </div>
                <h2 class="font-bold text-[#1A1A1A] text-base leading-snug mb-3 group-hover:text-[#C41230] transition-colors line-clamp-2">
                  {item.title}
                </h2>
                <p class="text-[#718096] text-sm leading-relaxed line-clamp-3">{item.excerpt}</p>
                <div class="mt-5 flex items-center gap-1 text-[#C41230] text-xs font-semibold">
                  Leer artículo completo
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
