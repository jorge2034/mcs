---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesGrid from '../components/vue/ServicesGrid.vue';
---

<BaseLayout
  title="Servicios"
  description="Comercio mayorista de minerales, logística minera, asesoramiento comercial, desarrollo de proyectos y más. Soluciones integrales para la industria minera boliviana."
>
  <!-- Hero -->
  <div class="relative pt-20 bg-[#0D0D0D] overflow-hidden">
    <div class="absolute inset-0 opacity-20"
      style="background-image: repeating-linear-gradient(45deg, #C41230 0, #C41230 1px, transparent 0, transparent 40px);">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="flex items-center gap-3 mb-4">
        <a href="/" class="text-white/40 hover:text-white/70 text-sm transition-colors">Inicio</a>
        <span class="text-white/30">/</span>
        <span class="text-[#C9A84C] text-sm">Servicios</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
        Nuestros <span class="text-[#C41230]">Servicios</span>
      </h1>
      <p class="text-white/60 text-xl max-w-2xl">
        Un portafolio completo de servicios especializados para la industria minera boliviana e internacional.
      </p>
    </div>
    <div class="h-1 bg-[#C41230]"></div>
  </div>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServicesGrid client:load />
    </div>
  </section>

  <section class="py-20 bg-[#C41230]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-white mb-4">
        ¿Listo para iniciar?
      </h2>
      <p class="text-white/80 text-lg mb-8">
        Contáctenos hoy mismo para conocer cómo podemos apoyar su operación minera.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 bg-white text-[#C41230] font-bold px-8 py-4 rounded hover:bg-[#1A1A1A] hover:text-white transition-all duration-300"
      >
        Solicitar Información
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
