---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/vue/ContactForm.vue';
import GoogleMap from '../components/ui/GoogleMap.astro';
---

<BaseLayout
  title="Contacto"
  description="Contáctenos para solicitar cotizaciones, información sobre minerales o asesoramiento comercial. Minera La Cordillera del Sur, Oruro, Bolivia."
>
  <!-- Hero -->
  <div class="relative pt-20 bg-[#0D0D0D] overflow-hidden">
    <div class="absolute inset-0 opacity-20"
      style="background-image: repeating-linear-gradient(45deg, #C41230 0, #C41230 1px, transparent 0, transparent 40px);">
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="flex items-center gap-3 mb-4">
        <a href="/" class="text-white/40 hover:text-white/70 text-sm transition-colors">Inicio</a>
        <span class="text-white/30">/</span>
        <span class="text-[#C9A84C] text-sm">Contacto</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">
        Hablemos de su <span class="text-[#C41230]">proyecto</span>
      </h1>
      <p class="text-white/60 text-xl max-w-2xl">
        Nuestro equipo de especialistas está disponible para asesorarle sobre comercialización de minerales y desarrollo de proyectos.
      </p>
    </div>
    <div class="h-1 bg-[#C41230]"></div>
  </div>

  <!-- Contact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- Info sidebar -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="font-display text-2xl font-bold text-[#1A1A1A] mb-6">Información de Contacto</h2>
            <div class="space-y-5">
              {[
                {
                  icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
                  label: 'Dirección',
                  value: 'Av. Principal s/n, Zona Central\nOruro, Bolivia'
                },
                {
                  icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
                  label: 'Teléfonos',
                  value: '+591 2 000 0000\n+591 70 000 000'
                },
                {
                  icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
                  label: 'Email',
                  value: 'info@mcs.com.bo\nventas@mcs.com.bo'
                },
              ].map(item => (
                <div class="flex gap-4 items-start">
                  <div class="w-11 h-11 bg-[#C41230]/10 rounded-xl flex items-center justify-center text-[#C41230] shrink-0">
                    <Fragment set:html={item.icon} />
                  </div>
                  <div>
                    <div class="text-[#718096] text-xs uppercase tracking-widest font-semibold mb-1">{item.label}</div>
                    <div class="text-[#1A1A1A] text-sm font-medium whitespace-pre-line">{item.value}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Business hours -->
          <div class="bg-[#F8F8F8] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-[#C41230]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Horario de Atención
            </h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-[#718096]">Lunes — Viernes</span>
                <span class="font-semibold text-[#1A1A1A]">8:00 — 17:00</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#718096]">Sábados</span>
                <span class="font-semibold text-[#1A1A1A]">9:00 — 13:00</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[#718096]">Domingos</span>
                <span class="text-[#718096]">Cerrado</span>
              </div>
            </div>
          </div>

          <GoogleMap class="rounded-2xl border border-gray-200" />
        </div>

        <!-- Form -->
        <div class="lg:col-span-3 bg-[#1A1A1A] rounded-2xl overflow-hidden">
          <div class="p-8">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
